# --- LLM backend selection (pluggable: ollama | anthropic | openai | openrouter) ---
A11Y_LLM_BACKEND=ollama
A11Y_LLM_MODEL=

# --- Ollama (local, default backend; no key required) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Cloud providers (only needed if A11Y_LLM_BACKEND selects them) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- GitHub PR delivery (live if GITHUB_TOKEN is set, dry-run otherwise) ---
GITHUB_TOKEN=
GITHUB_REPO=mdrmtz/Hallucinate.io

# --- Fixture path override (defaults to <repo_root>/Hallucinate.io) ---
A11Y_FIXTURE_PATH=

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=a11y-fixer
